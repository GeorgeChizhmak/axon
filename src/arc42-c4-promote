#!/usr/bin/env bash
set -euo pipefail
eval "$($(dirname "$0")/arc42-c4-config)"

## usage: arc42-c4 promote <EXPERIMENT_NUM> [-t "ADR Title Override"]
##
## Promotes a successful experiment to a new Architecture Decision Record.
## This command:
##
##   1. Reads the experiment file (experiments/NNNN-*.adoc)
##   2. Creates a new ADR using the experiment title (or a custom title with -t)
##   3. Pre-fills the ADR Context from the experiment's Hypothesis and Setup
##   4. Pre-fills the ADR Decision from the experiment's Conclusion
##   5. Marks the experiment status as PROMOTED-TO-ADR with a cross-reference
##   6. Opens the new ADR in your editor for final review
##
## Arguments:
##   EXPERIMENT_NUM   The sequential number of the experiment to promote
##
## Options:
##   -t TITLE   Override the ADR title (default: experiment title is reused)
##
## Examples:
##   arc42-c4 promote 3
##   arc42-c4 promote 3 -t "Adopt Redis for Session Caching"

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'
info()    { echo -e "${CYAN}[arc42-c4]${NC} $*"; }
success() { echo -e "${GREEN}[arc42-c4] ✓${NC} $*"; }
warn()    { echo -e "${YELLOW}[arc42-c4] ⚠${NC} $*"; }
error()   { echo -e "${RED}[arc42-c4] ✗${NC} $*" >&2; }

# ── Parse arguments ───────────────────────────────────────────────────────────
if [ $# -eq 0 ]; then
    error "No experiment number given."
    echo "Usage: arc42-c4 promote <EXPERIMENT_NUM> [-t \"ADR Title\"]" >&2
    exit 1
fi

EXP_NUM="$1"
shift
ADR_TITLE_OVERRIDE=""

while getopts "t:" opt; do
    case "$opt" in
        t) ADR_TITLE_OVERRIDE="$OPTARG" ;;
        *) error "Unknown option: -$opt"; exit 1 ;;
    esac
done

# ── Resolve docs root ─────────────────────────────────────────────────────────
DOCS_DIR="$("$arc42c4_bin_dir/_arc42c4_dir")"
EXP_ID=$(printf "%04d" "$EXP_NUM")
EXP_FILE=$(ls "$DOCS_DIR/experiments/${EXP_ID}-"*.adoc 2>/dev/null | head -1)

if [ -z "$EXP_FILE" ]; then
    error "Experiment #${EXP_NUM} not found in $DOCS_DIR/experiments/"
    echo "Run 'arc42-c4 list experiment' to see available experiments." >&2
    exit 1
fi

EXP_BASENAME=$(basename "$EXP_FILE" .adoc)
EXP_SLUG="${EXP_BASENAME#*-}"

info "Promoting experiment: $EXP_BASENAME"

# ── Extract sections from experiment file ─────────────────────────────────────
# We extract text between section headers using awk.

extract_section() {
    local file="$1"
    local section="$2"
    awk "
        /^=== ${section}/{found=1; next}
        found && /^=== /{found=0}
        found && /^==/{found=0}
        found{print}
    " "$file" | sed '/^$/d' | head -20
}

HYPOTHESIS=$(extract_section "$EXP_FILE" "Hypothesis")
SETUP=$(extract_section "$EXP_FILE" "Approach")
CONCLUSION=$(extract_section "$EXP_FILE" "Conclusion")
FINDINGS=$(extract_section "$EXP_FILE" "Findings")

# ── Determine ADR title ───────────────────────────────────────────────────────
if [ -n "$ADR_TITLE_OVERRIDE" ]; then
    ADR_TITLE="$ADR_TITLE_OVERRIDE"
else
    # Extract title from the first == heading of the experiment file
    EXP_TITLE=$(grep -m1 '^== Experiment:' "$EXP_FILE" | sed 's/^== Experiment: //')
    ADR_TITLE="${EXP_TITLE:-Promoted from Experiment #${EXP_NUM}}"
fi

# ── Calculate next ADR number ─────────────────────────────────────────────────
ADR_DIR="$DOCS_DIR/adrs"
mkdir -p "$ADR_DIR"

if ls "$ADR_DIR"/*.adoc >/dev/null 2>&1; then
    MAXID=$(ls "$ADR_DIR"/*.adoc | xargs -I{} basename {} | grep -Eo '^[0-9]+' | sed 's/^0*//' | sort -rn | head -1)
    ADR_NUM=$(( MAXID + 1 ))
else
    ADR_NUM=1
fi

ADR_ID=$(printf "%04d" "$ADR_NUM")
ADR_SLUG=$(echo -n "$ADR_TITLE" | tr -Ccs '[:alnum:]' '-' | tr '[:upper:]' '[:lower:]' | sed 's/^-//;s/-$//')
ADR_FILE="$ADR_DIR/${ADR_ID}-${ADR_SLUG}.adoc"
DATE="${ARC42C4_DATE:-$(date +%Y-%m-%d)}"

# ── Build the pre-filled ADR ──────────────────────────────────────────────────
cat > "$ADR_FILE" <<ADOC
== ${ADR_TITLE}

[NOTE]
====
*Status:* \`ACCEPTED\` +
*Date:* ${DATE} +
_Promoted from link:../experiments/${EXP_BASENAME}.adoc[Experiment #${EXP_NUM}]_
====

=== Context

// Pre-filled from the experiment hypothesis and setup. Review and edit as needed.
${HYPOTHESIS:-[TODO: Describe the context and motivation for this decision.]}

${SETUP:+**Experimental approach:** ${SETUP}}

=== Decision

// Pre-filled from the experiment conclusion. Review and edit as needed.
${CONCLUSION:-[TODO: Describe the architectural decision.]}

=== Rationale

// Pre-filled from the experiment findings. Review and edit as needed.
${FINDINGS:-[TODO: Explain why this option was chosen over alternatives.]}

The decision is backed by Experiment #${EXP_NUM} (link:../experiments/${EXP_BASENAME}.adoc[${EXP_BASENAME}]).

=== Consequences

What becomes easier or more difficult to do as a result of this decision.
Any risks introduced that will need to be mitigated.
ADOC

# ── Auto-inject include:: into Arc42 section 09 ───────────────────────────────
AGGREGATOR="$DOCS_DIR/arc42/09_architecture_decisions.adoc"
if [ -f "$AGGREGATOR" ]; then
    INCLUDE_LINE="include::../adrs/${ADR_ID}-${ADR_SLUG}.adoc[]"
    TMPFILE=$(mktemp)
    awk -v line="$INCLUDE_LINE" '
        /^:leveloffset: -1/ {
            print ""
            print "// horizontal line"
            print "***"
            print "<<<<"
            print line
            print ""
        }
        { print }
    ' "$AGGREGATOR" > "$TMPFILE"
    mv "$TMPFILE" "$AGGREGATOR"
fi

# ── Mark experiment as PROMOTED-TO-ADR ────────────────────────────────────────
sed -i "s|^\*Status:\* \`.*\`|\*Status:\* \`PROMOTED-TO-ADR\`|" "$EXP_FILE"

# Append cross-reference to the experiment file
cat >> "$EXP_FILE" <<NOTE

// ── Promotion record ──────────────────────────────────────────────────────────
[NOTE]
====
*Promoted to ADR:* link:../adrs/${ADR_ID}-${ADR_SLUG}.adoc[ADR #${ADR_NUM} — ${ADR_TITLE}] +
*Promoted on:* ${DATE}
====
NOTE

# ── Open in editor ────────────────────────────────────────────────────────────
${VISUAL:-${EDITOR:-true}} "$ADR_FILE"

echo ""
success "Experiment #${EXP_NUM} promoted to ADR #${ADR_NUM}"
info "  Experiment : $EXP_FILE"
info "  New ADR    : $ADR_FILE"
echo ""
