#!/usr/bin/env bash
# Resolves the documentation root directory for the current project.
# Reads .axon-dir from the nearest ancestor directory containing it,
# falling back to "documentation" if no config file is found.
#
# Usage: dstdir=$("$axon_bin_dir/_axon_dir")

set -e

# Walk up the directory tree looking for .axon-dir
dir="$PWD"
while [ "$dir" != "/" ]; do
    if [ -f "$dir/.axon-dir" ]; then
        cat "$dir/.axon-dir"
        exit 0
    fi
    dir="$(dirname "$dir")"
done

# Fallback: check current directory directly
if [ -f ".axon-dir" ]; then
    cat .axon-dir
else
    echo "documentation"
fi
