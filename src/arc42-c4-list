#!/usr/bin/env bash
set -euo pipefail
eval "$($(dirname "$0")/arc42-c4-config)"

## usage: arc42-c4 list [TYPE]
##
## Lists documents in the workspace. If TYPE is given, lists only documents
## of that type with their sequential number, slug, and status.
## Without TYPE, shows a summary of all document types and counts.
##
## TYPE must be one of:
##   adr, tdr, data-card, model-card, runbook, guideline
##
## Examples:
##   arc42-c4 list          # Show summary of all types
##   arc42-c4 list adr      # List all ADRs
##   arc42-c4 list tdr      # List all TDRs

# ── Colours ───────────────────────────────────────────────────────────────────
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

declare -A TYPE_DIRS=(
    [adr]="adrs"
    [tdr]="tdrs"
    [data-card]="data-cards"
    [model-card]="model-cards"
    [runbook]="runbooks"
    [guideline]="guidelines"
    [experiment]="experiments"
)

DOCS_DIR="$("$arc42c4_bin_dir/_arc42c4_dir")"

# Extract status from the NOTE block (*Status:* `VALUE`)
get_status() {
    local file="$1"
    grep -oP '(?<=\*Status:\* `).*(?=`)' "$file" 2>/dev/null | head -1 || echo "UNKNOWN"
}

# List a single type
list_type() {
    local type="$1"
    local subdir="$DOCS_DIR/${TYPE_DIRS[$type]}"

    if [ ! -d "$subdir" ]; then
        echo -e "  ${YELLOW}(directory not found: $subdir)${NC}"
        return
    fi

    shopt -s nullglob
    local files=("$subdir/"[0-9]*.adoc)
    shopt -u nullglob

    if [ ${#files[@]} -eq 0 ]; then
        echo -e "  ${YELLOW}(none)${NC}"
        return
    fi

    for f in "${files[@]}"; do
        local basename
        basename=$(basename "$f" .adoc)
        local num="${basename%%-*}"
        local slug="${basename#*-}"
        local status
        status=$(get_status "$f")

        # Colour-code status
        local status_colour="$NC"
        case "$status" in
            ACCEPTED|ACTIVE|SUCCEEDED)    status_colour="$GREEN" ;;
            OPEN|DRAFT|INCONCLUSIVE)      status_colour="$YELLOW" ;;
            SUPERSEDED|DEPRECATED|FAILED|ABANDONED) status_colour='\033[0;31m' ;;
            PROMOTED-TO-ADR)              status_colour="$CYAN" ;;
        esac

        printf "  %-6s %-50s %b%s%b\n" \
            "$num" "$slug" "$status_colour" "$status" "$NC"
    done
}

# ── Main ──────────────────────────────────────────────────────────────────────
if [ $# -eq 0 ]; then
    # Summary mode: all types
    echo ""
    echo -e "${CYAN}${BOLD}Arc42-C4 Documentation Workspace${NC}"
    echo -e "${CYAN}Docs root: $DOCS_DIR${NC}"
    echo ""

    for type in adr tdr experiment data-card model-card runbook guideline; do
        subdir="$DOCS_DIR/${TYPE_DIRS[$type]}"
        shopt -s nullglob
        files=("$subdir/"[0-9]*.adoc)
        shopt -u nullglob
        count=${#files[@]}
        printf "  ${BOLD}%-14s${NC} %d document(s)\n" "$type" "$count"
    done
    echo ""
    echo "Run 'arc42-c4 list <type>' to see details."
    echo ""
else
    TYPE="$1"

    if [ -z "${TYPE_DIRS[$TYPE]+x}" ]; then
        echo "Unknown type: '$TYPE'. Valid: adr, tdr, experiment, data-card, model-card, runbook, guideline" >&2
        exit 1
    fi

    echo ""
    echo -e "${CYAN}${BOLD}${TYPE^^} documents${NC} — $DOCS_DIR/${TYPE_DIRS[$TYPE]}/"
    echo ""
    list_type "$TYPE"
    echo ""
fi
