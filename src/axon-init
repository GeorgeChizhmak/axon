#!/usr/bin/env bash
set -euo pipefail
eval "$($(dirname "$0")/axon-config)"

## usage: axon init [DIRECTORY] [-n "Project Name"] [-a "Author <email>"]
##
## Initialises a new Arc42 + C4 Model documentation workspace:
##
##   * Creates a .axon-dir config file in the current directory
##   * Scaffolds the full arc42/ chapter structure (13 AsciiDoc sections)
##   * Copies a starter workspace.dsl for the C4 model
##   * Creates subdirectories: adrs/, tdrs/, data-cards/, model-cards/,
##     runbooks/, guidelines/, diagrams/
##   * Writes a project README.adoc at the project root
##   * Creates the master <project>.adoc aggregator for HTML/PDF rendering
##   * Records the first ADR: "Use Architecture Decision Records"
##
## Arguments:
##   DIRECTORY    Where to create the documentation tree (default: documentation)
##
## Options:
##   -n NAME      Project name (default: "My Project")
##   -a AUTHOR    Author string, e.g. "Jane Doe <jane@example.com>"
##                (default: "Author <author@example.com>")
##
## Example:
##   axon init documentation -n "Order Service" -a "Jane <jane@acme.com>"

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'
info()    { printf "${CYAN}[axon]${NC} %s\n" "$*"; }
success() { printf "${GREEN}[axon] \xe2\x9c\x93${NC} %s\n" "$*"; }
warn()    { printf "${YELLOW}[axon] \xe2\x9a\xa0${NC} %s\n" "$*"; }
error()   { printf "${RED}[axon] \xe2\x9c\x97${NC} %s\n" "$*" >&2; }

# ── Defaults ─────────────────────────────────────────────────────────────────
DOCS_DIR="documentation"
PROJECT_NAME="My Project"
AUTHOR="Author <author@example.com>"

# ── Parse positional DIRECTORY then options ──────────────────────────────────
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    DOCS_DIR="$1"
    shift
fi

while getopts "n:a:" opt; do
    case "$opt" in
        n) PROJECT_NAME="$OPTARG" ;;
        a) AUTHOR="$OPTARG" ;;
        *) error "Unknown option: -$opt"; exit 1 ;;
    esac
done

# ── Derived values ────────────────────────────────────────────────────────────
PROJECT_SLUG=$(echo "$PROJECT_NAME" | tr -cs '[:alnum:]' '-' | tr '[:upper:]' '[:lower:]' | sed 's/^-//;s/-$//')
TODAY=$(date +%Y-%m-%d)
YEAR=$(date +%Y)

# ── Guard: already initialised ────────────────────────────────────────────────
if [ -f ".axon-dir" ]; then
    warn ".axon-dir already exists. Workspace appears to be initialised."
    warn "Remove .axon-dir to re-initialise."
    exit 1
fi

printf "\n"
printf "${CYAN}══════════════════════════════════════════════════════${NC}\n"
printf "${CYAN}   axon — Initialising Engineering Workspace         ${NC}\n"
printf "${CYAN}══════════════════════════════════════════════════════${NC}\n"
printf "\n"
info "Project name : $PROJECT_NAME"
info "Author       : $AUTHOR"
info "Docs dir     : $DOCS_DIR"
printf "\n"

# ── 1. Write .axon-dir ───────────────────────────────────────────────────────
printf "%s\n" "$DOCS_DIR" > .axon-dir
success "Created .axon-dir"

# ── Helper: substitute tokens in a template file and write to destination ─────
render_template() {
    local src="$1"
    local dst="$2"
    mkdir -p "$(dirname "$dst")"
    sed \
        -e "s|PROJECT_NAME|${PROJECT_NAME}|g" \
        -e "s|PROJECT_SLUG|${PROJECT_SLUG}|g" \
        -e "s|AUTHOR|${AUTHOR}|g" \
        -e "s|TODAY|${TODAY}|g" \
        -e "s|YEAR|${YEAR}|g" \
        "$src" > "$dst"
}

# ── 2. Scaffold arc42/ chapters ───────────────────────────────────────────────
info "Scaffolding arc42/ chapters..."
for f in "$axon_template_dir/arc42/"*.adoc; do
    fname="$(basename "$f")"
    render_template "$f" "$DOCS_DIR/arc42/$fname"
done
success "arc42/ chapters written to $DOCS_DIR/arc42/"

# ── 3. Copy workspace.dsl ────────────────────────────────────────────────────
info "Copying workspace.dsl..."
render_template "$axon_template_dir/workspace.dsl" "$DOCS_DIR/workspace.dsl"
success "C4 workspace DSL → $DOCS_DIR/workspace.dsl"

# ── 4. Create master adoc aggregator ─────────────────────────────────────────
info "Creating master AsciiDoc aggregator..."
render_template "$axon_template_dir/main.adoc" "$DOCS_DIR/${PROJECT_SLUG}.adoc"
success "Master aggregator → $DOCS_DIR/${PROJECT_SLUG}.adoc"

# ── 5. Create subdirectories ──────────────────────────────────────────────────
info "Creating document subdirectories..."
for subdir in adrs tdrs experiments epics tasks meetings data-cards model-cards runbooks guidelines diagrams; do
    mkdir -p "$DOCS_DIR/$subdir"
done
success "Subdirectories created under $DOCS_DIR/"

# ── 6. Write README.adoc ──────────────────────────────────────────────────────
info "Writing README.adoc..."
render_template "$axon_template_dir/README.adoc" "README.adoc"
success "README.adoc written"

# ── 7. Create ADR #0001 silently (no editor) ─────────────────────────────────
info "Creating ADR #0001: Record Architecture Decisions..."
VISUAL=true \
  AXON_DOCS_DIR="$DOCS_DIR" \
  "$axon_bin_dir/axon-new" adr "Record Architecture Decisions"
success "ADR #0001 created"

printf "\n"
success "Workspace initialised! Next steps:"
printf "\n"
printf "  1. Edit %s/workspace.dsl to model your C4 architecture\n" "$DOCS_DIR"
printf "  2. Fill in arc42/ chapter files with your project details\n"
printf "  3. Run 'axon new adr \"My Decision\"' to add architecture decisions\n"
printf "  4. Run 'axon new epic \"My Epic\"' to track project epics and timelines\n"
printf "  5. Run 'axon new task -c FEAT \"My Task\"' to add tasks to the board\n"
printf "  6. Run 'axon board' to build the visual Kanban board (BOARD.html)\n"
printf "  7. Run 'axon new meeting \"Sprint Planning\"' to log meeting agendas\n"
printf "  8. Run 'axon generate' to build HTML and PDF reports\n"
printf "\n"
printf "  ${CYAN}Scaffolded with axon — George Chizhmak, 2026${NC}\n"
printf "\n"
