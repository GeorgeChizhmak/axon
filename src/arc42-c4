#!/usr/bin/env bash
set -e
eval "$($(dirname "$0")/arc42-c4-config)"

## usage: arc42-c4 COMMAND [ARGS...]
##
## arc42-c4 is a tool for managing Arc42 + C4 Model architecture documentation
## workspaces using AsciiDoc. It follows the same conventions as adr-tools.
##
## Commands:
##   init       Initialise a new documentation workspace
##   new        Create a new document (adr, tdr, data-card, model-card, runbook, guideline)
##   generate   Render HTML and PDF documentation reports
##   list       List documents of a given type
##   help       Show help for a command
##
## Run 'arc42-c4 help COMMAND' for help on a specific command.

cmd="$arc42c4_bin_dir/arc42-c4-$1"

if [ -x "$cmd" ]; then
    "$cmd" "${@:2}"
else
    "$arc42c4_bin_dir/arc42-c4-help"
    exit 1
fi
