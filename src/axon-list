#!/usr/bin/env bash
set -euo pipefail
eval "$($(dirname "$0")/axon-config)"

## usage: axon list [TYPE] [--board]
##
## Lists documents in the workspace. If TYPE is given, lists only documents
## of that type with their sequential number, slug, and status.
## Without TYPE, shows a summary of all document types and counts.
##
## TYPE must be one of:
##   adr, tdr, experiment, epic, task, meeting, data-card, model-card, runbook, guideline
##
## Options:
##   --board   For 'task' type, show a Kanban-style board grouped by status
##
## Examples:
##   axon list          # Show summary of all types
##   axon list adr      # List all ADRs
##   axon list task     # List all tasks with class and assignee
##   axon list task --board  # Show tasks in Kanban columns

# ── Colours ───────────────────────────────────────────────────────────────────
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

declare -A TYPE_DIRS=(
    [adr]="adrs"
    [tdr]="tdrs"
    [data-card]="data-cards"
    [model-card]="model-cards"
    [runbook]="runbooks"
    [guideline]="guidelines"
    [experiment]="experiments"
    [epic]="epics"
    [task]="tasks"
    [meeting]="meetings"
)

DOCS_DIR="$("$axon_bin_dir/_axon_dir")"

# Extract status from the NOTE block (*Status:* `VALUE`)
get_status() {
    local file="$1"
    grep -oP '(?<=\*Status:\* `).*(?=`)' "$file" 2>/dev/null | head -1 || echo "UNKNOWN"
}

# Extract a metadata field from the NOTE block (*Field:* `VALUE` or *Field:* VALUE)
# Strips trailing AsciiDoc line-continuation ' +' to avoid display noise.
get_field() {
    local file="$1"
    local field="$2"
    local val
    # Prefer backtick-quoted value
    val=$(grep -oP "(?<=\*${field}:\* \`).*(?=\`)" "$file" 2>/dev/null | head -1) \
        || true
    if [ -z "$val" ]; then
        # Fall back to unquoted value — strip trailing ' +' and whitespace
        val=$(grep -oP "(?<=\*${field}:\* ).*" "$file" 2>/dev/null | head -1 \
              | sed 's/ +[[:space:]]*$//' | sed 's/[[:space:]]*$//' || true)
    fi
    echo "${val:-—}"
}

# Colour-code a status string, outputs the escape sequence
status_colour() {
    local status="$1"
    case "$status" in
        ACCEPTED|ACTIVE|SUCCEEDED|COMPLETED|DONE) printf '\033[0;32m' ;;
        OPEN|DRAFT|INCONCLUSIVE|PLANNING|SCHEDULED|TODO) printf '\033[1;33m' ;;
        IN-PROGRESS) printf '\033[0;36m' ;;
        SUPERSEDED|DEPRECATED|FAILED|ABANDONED|CANCELLED) printf '\033[0;31m' ;;
        PROMOTED-TO-ADR) printf '\033[0;36m' ;;
        BLOCKED) printf '\033[0;31m' ;;
        *) printf '\033[0m' ;;
    esac
}

# List a single type (standard tabular view)
list_type() {
    local type="$1"
    local subdir="$DOCS_DIR/${TYPE_DIRS[$type]}"

    if [ ! -d "$subdir" ]; then
        echo -e "  \033[1;33m(directory not found: $subdir)\033[0m"
        return
    fi

    shopt -s nullglob
    local files=("$subdir/"[0-9]*.adoc)
    shopt -u nullglob

    if [ ${#files[@]} -eq 0 ]; then
        echo -e "  \033[1;33m(none)\033[0m"
        return
    fi

    for f in "${files[@]}"; do
        local basename
        basename=$(basename "$f" .adoc)
        local num="${basename%%-*}"
        local slug="${basename#*-}"
        local status
        status=$(get_status "$f")
        local sc
        sc=$(status_colour "$status")

        if [ "$type" = "task" ]; then
            local class assignee
            class=$(get_field "$f" "Class")
            assignee=$(get_field "$f" "Assignee")
            printf "  %-6s %-8s %-42s %-18s %b%s\033[0m\n" \
                "$num" "$class" "$slug" "$assignee" "$sc" "$status"
        elif [ "$type" = "epic" ]; then
            local priority
            priority=$(get_field "$f" "Priority")
            printf "  %-6s %-10s %-42s %b%s\033[0m\n" \
                "$num" "$priority" "$slug" "$sc" "$status"
        elif [ "$type" = "meeting" ]; then
            local date
            date=$(get_field "$f" "Date")
            printf "  %-6s %-12s %-42s %b%s\033[0m\n" \
                "$num" "$date" "$slug" "$sc" "$status"
        else
            printf "  %-6s %-50s %b%s\033[0m\n" \
                "$num" "$slug" "$sc" "$status"
        fi
    done
}

# Kanban board for tasks grouped by status column
list_task_board() {
    local subdir="$DOCS_DIR/${TYPE_DIRS[task]}"

    if [ ! -d "$subdir" ]; then
        echo -e "  \033[1;33m(directory not found: $subdir)\033[0m"
        return
    fi

    shopt -s nullglob
    local files=("$subdir/"[0-9]*.adoc)
    shopt -u nullglob

    if [ ${#files[@]} -eq 0 ]; then
        echo -e "  \033[1;33m(no tasks)\033[0m"
        return
    fi

    # Collect entries into per-status temp files
    local tmpdir
    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' RETURN

    for f in "${files[@]}"; do
        local basename num slug status class assignee
        basename=$(basename "$f" .adoc)
        num="${basename%%-*}"
        slug="${basename#*-}"
        status=$(get_status "$f")
        class=$(get_field "$f" "Class")
        assignee=$(get_field "$f" "Assignee")
        local entry
        entry=$(printf "[%-5s] #%-4s %-28s %s" "$class" "$num" "$slug" "$assignee")

        case "$status" in
            TODO)        echo "$entry" >> "$tmpdir/todo" ;;
            IN-PROGRESS) echo "$entry" >> "$tmpdir/inprogress" ;;
            BLOCKED)     echo "$entry" >> "$tmpdir/blocked" ;;
            DONE|COMPLETED|SUCCEEDED|PROMOTED-TO-ADR) echo "$entry" >> "$tmpdir/done" ;;
            *)           echo "$entry" >> "$tmpdir/todo" ;;
        esac
    done

    # Print board header
    printf "\n"
    printf "\033[1;33m\033[1m %-48s\033[0m  " "📋 TODO"
    printf "\033[0;36m\033[1m %-48s\033[0m  " "🔵 IN-PROGRESS"
    printf "\033[0;31m\033[1m %-48s\033[0m  " "🔴 BLOCKED"
    printf "\033[0;32m\033[1m %-48s\033[0m\n" "✅ DONE"
    local sep
    sep=$(printf '%0.s─' {1..50})
    printf " %s   %s   %s   %s\n" "$sep" "$sep" "$sep" "$sep"

    # Find max row count across all columns
    local max_rows=0
    for col in todo inprogress blocked done; do
        local cnt=0
        [ -f "$tmpdir/$col" ] && cnt=$(wc -l < "$tmpdir/$col")
        [ "$cnt" -gt "$max_rows" ] && max_rows="$cnt"
    done

    # Print rows
    for (( i=1; i<=max_rows; i++ )); do
        local t ip bl d
        t=$(  [ -f "$tmpdir/todo" ]       && sed -n "${i}p" "$tmpdir/todo"       || true)
        ip=$( [ -f "$tmpdir/inprogress" ] && sed -n "${i}p" "$tmpdir/inprogress" || true)
        bl=$( [ -f "$tmpdir/blocked" ]    && sed -n "${i}p" "$tmpdir/blocked"    || true)
        d=$(  [ -f "$tmpdir/done" ]        && sed -n "${i}p" "$tmpdir/done"       || true)
        printf " %-48s   %-48s   %-48s   %-48s\n" \
            "${t:-}" "${ip:-}" "${bl:-}" "${d:-}"
    done
    printf "\n"
}

# ── Main ──────────────────────────────────────────────────────────────────────
BOARD_MODE=false
ARGS=()
for arg in "$@"; do
    [ "$arg" = "--board" ] && BOARD_MODE=true || ARGS+=("$arg")
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

if [ $# -eq 0 ]; then
    # Summary mode: all types
    echo ""
    echo -e "\033[0;36m\033[1mAxon Engineering Workspace\033[0m"
    echo -e "\033[0;36mDocs root: $DOCS_DIR\033[0m"
    echo ""
    echo -e "\033[1mProject Management:\033[0m"
    for type in epic task meeting; do
        subdir="$DOCS_DIR/${TYPE_DIRS[$type]}"
        shopt -s nullglob
        files=("$subdir/"[0-9]*.adoc)
        shopt -u nullglob
        count=${#files[@]}
        printf "  \033[1m%-14s\033[0m %d document(s)\n" "$type" "$count"
    done
    echo ""
    echo -e "\033[1mArchitecture & Decisions:\033[0m"
    for type in adr tdr experiment; do
        subdir="$DOCS_DIR/${TYPE_DIRS[$type]}"
        shopt -s nullglob
        files=("$subdir/"[0-9]*.adoc)
        shopt -u nullglob
        count=${#files[@]}
        printf "  \033[1m%-14s\033[0m %d document(s)\n" "$type" "$count"
    done
    echo ""
    echo -e "\033[1mSupporting Documents:\033[0m"
    for type in data-card model-card runbook guideline; do
        subdir="$DOCS_DIR/${TYPE_DIRS[$type]}"
        shopt -s nullglob
        files=("$subdir/"[0-9]*.adoc)
        shopt -u nullglob
        count=${#files[@]}
        printf "  \033[1m%-14s\033[0m %d document(s)\n" "$type" "$count"
    done
    echo ""
    echo "Run 'axon list <type>' to see details. Use 'axon list task --board' for Kanban view."
    echo ""
else
    TYPE="$1"

    if [ -z "${TYPE_DIRS[$TYPE]+x}" ]; then
        echo "Unknown type: '$TYPE'. Valid: adr, tdr, experiment, epic, task, meeting, data-card, model-card, runbook, guideline" >&2
        exit 1
    fi

    echo ""
    echo -e "\033[0;36m\033[1m${TYPE^^} documents\033[0m — $DOCS_DIR/${TYPE_DIRS[$TYPE]}/"
    echo ""

    if [ "$TYPE" = "task" ] && $BOARD_MODE; then
        list_task_board
    else
        if [ "$TYPE" = "task" ]; then
            printf "  %-6s %-8s %-42s %-18s %s\n" "#" "CLASS" "SLUG" "ASSIGNEE" "STATUS"
            printf "  %s\n" "$(printf '─%.0s' {1..90})"
        elif [ "$TYPE" = "epic" ]; then
            printf "  %-6s %-10s %-42s %s\n" "#" "PRIORITY" "SLUG" "STATUS"
            printf "  %s\n" "$(printf '─%.0s' {1..70})"
        elif [ "$TYPE" = "meeting" ]; then
            printf "  %-6s %-12s %-42s %s\n" "#" "DATE" "SLUG" "STATUS"
            printf "  %s\n" "$(printf '─%.0s' {1..72})"
        fi
        list_type "$TYPE"
    fi
    echo ""
fi
