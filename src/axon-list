#!/usr/bin/env bash
set -euo pipefail
eval "$($(dirname "$0")/axon-config)"

## usage: axon list [TYPE] [--board]
##
## Lists documents in the workspace. If TYPE is given, lists only documents
## of that type with their sequential number, slug, and status.
## Without TYPE, shows a summary of all document types and counts.
##
## TYPE must be one of:
##   adr, tdr, experiment, epic, task, meeting, data-card, model-card, runbook, guideline
##
## Options:
##   --board   For 'task' type, show a Kanban-style board grouped by status
##
## Examples:
##   axon list          # Show summary of all types
##   axon list adr      # List all ADRs
##   axon list task     # List all tasks with class and assignee
##   axon list task --board  # Show tasks in Kanban columns

# ── Colours ───────────────────────────────────────────────────────────────────
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

# ── Type → subdir helper (portable; no associative arrays required) ────────────
type_dir() {
    case "$1" in
        adr)        echo "adrs" ;;
        tdr)        echo "tdrs" ;;
        data-card)  echo "data-cards" ;;
        model-card) echo "model-cards" ;;
        runbook)    echo "runbooks" ;;
        guideline)  echo "guidelines" ;;
        experiment) echo "experiments" ;;
        epic)       echo "epics" ;;
        task)       echo "tasks" ;;
        meeting)    echo "meetings" ;;
        *)          echo "" ;;
    esac
}

DOCS_DIR="$("$axon_bin_dir/_axon_dir")"

# Extract status from the NOTE block (*Status:* `VALUE`)
# Uses portable sed instead of grep -oP (PCRE lookbehind)
get_status() {
    local file="$1"
    sed -n "s/.*\*Status:\* \`\([^']*\)\`.*/\1/p" "$file" 2>/dev/null | head -1 || echo "UNKNOWN"
}

# Extract a metadata field from the NOTE block (*Field:* `VALUE` or *Field:* VALUE)
# Strips trailing AsciiDoc line-continuation ' +' to avoid display noise.
get_field() {
    local file="$1"
    local field="$2"
    local val
    # Try backtick-quoted value first
    val=$(sed -n "s/.*\*${field}:\* \`\([^\`]*\)\`.*/\1/p" "$file" 2>/dev/null | head -1 || true)
    if [ -z "$val" ]; then
        # Fall back to unquoted value — strip trailing ' +' and whitespace
        val=$(grep "\*${field}:\*" "$file" 2>/dev/null | head -1 \
              | sed "s/.*\*${field}:\* //" \
              | sed 's/ +[[:space:]]*$//' \
              | sed 's/[[:space:]]*$//' || true)
    fi
    printf "%s" "${val:-—}"
}

# Colour-code a status string, outputs the escape sequence
status_colour() {
    local status="$1"
    case "$status" in
        ACCEPTED|ACTIVE|SUCCEEDED|COMPLETED|DONE) printf '\033[0;32m' ;;
        OPEN|DRAFT|INCONCLUSIVE|PLANNING|SCHEDULED|TODO) printf '\033[1;33m' ;;
        IN-PROGRESS) printf '\033[0;36m' ;;
        SUPERSEDED|DEPRECATED|FAILED|ABANDONED|CANCELLED) printf '\033[0;31m' ;;
        PROMOTED-TO-ADR) printf '\033[0;36m' ;;
        BLOCKED) printf '\033[0;31m' ;;
        *) printf '\033[0m' ;;
    esac
}

# List a single type (standard tabular view)
list_type() {
    local type="$1"
    local subdir="$DOCS_DIR/$(type_dir "$type")"

    if [ ! -d "$subdir" ]; then
        printf "  \033[1;33m(directory not found: %s)\033[0m\n" "$subdir"
        return
    fi

    # Collect matching files into a variable-length list (bash 3.2 compatible)
    local files_found=false
    for f in "$subdir"/[0-9]*.adoc; do
        [ -e "$f" ] || continue
        files_found=true
        local bname
        bname=$(basename "$f" .adoc)
        local num="${bname%%-*}"
        local slug="${bname#*-}"
        local status
        status=$(get_status "$f")
        local sc
        sc=$(status_colour "$status")

        if [ "$type" = "task" ]; then
            local class assignee
            class=$(get_field "$f" "Class")
            assignee=$(get_field "$f" "Assignee")
            printf "  %-6s %-8s %-42s %-18s %b%s\033[0m\n" \
                "$num" "$class" "$slug" "$assignee" "$sc" "$status"
        elif [ "$type" = "epic" ]; then
            local priority
            priority=$(get_field "$f" "Priority")
            printf "  %-6s %-10s %-42s %b%s\033[0m\n" \
                "$num" "$priority" "$slug" "$sc" "$status"
        elif [ "$type" = "meeting" ]; then
            local date
            date=$(get_field "$f" "Date")
            printf "  %-6s %-12s %-42s %b%s\033[0m\n" \
                "$num" "$date" "$slug" "$sc" "$status"
        else
            printf "  %-6s %-50s %b%s\033[0m\n" \
                "$num" "$slug" "$sc" "$status"
        fi
    done

    if ! $files_found; then
        printf "  \033[1;33m(none)\033[0m\n"
    fi
}

# Kanban board for tasks grouped by status column
list_task_board() {
    local subdir="$DOCS_DIR/$(type_dir "task")"

    if [ ! -d "$subdir" ]; then
        printf "  \033[1;33m(directory not found: %s)\033[0m\n" "$subdir"
        return
    fi

    # Collect entries into per-status temp files
    local tmpdir
    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' RETURN

    local files_found=false
    for f in "$subdir"/[0-9]*.adoc; do
        [ -e "$f" ] || continue
        files_found=true
        local bname num slug status class assignee entry
        bname=$(basename "$f" .adoc)
        num="${bname%%-*}"
        slug="${bname#*-}"
        status=$(get_status "$f")
        class=$(get_field "$f" "Class")
        assignee=$(get_field "$f" "Assignee")
        entry=$(printf "[%-5s] #%-4s %-28s %s" "$class" "$num" "$slug" "$assignee")

        case "$status" in
            TODO)        printf "%s\n" "$entry" >> "$tmpdir/todo" ;;
            IN-PROGRESS) printf "%s\n" "$entry" >> "$tmpdir/inprogress" ;;
            BLOCKED)     printf "%s\n" "$entry" >> "$tmpdir/blocked" ;;
            DONE|COMPLETED|SUCCEEDED|PROMOTED-TO-ADR) printf "%s\n" "$entry" >> "$tmpdir/done" ;;
            *)           printf "%s\n" "$entry" >> "$tmpdir/todo" ;;
        esac
    done

    if ! $files_found; then
        printf "  \033[1;33m(no tasks)\033[0m\n"
        return
    fi

    # Print board header
    printf "\n"
    printf "\033[1;33m\033[1m %-48s\033[0m  " "📋 TODO"
    printf "\033[0;36m\033[1m %-48s\033[0m  " "🔵 IN-PROGRESS"
    printf "\033[0;31m\033[1m %-48s\033[0m  " "🔴 BLOCKED"
    printf "\033[0;32m\033[1m %-48s\033[0m\n" "✅ DONE"
    local sep
    sep="$(printf '%0.s─' $(seq 1 50))"
    printf " %s   %s   %s   %s\n" "$sep" "$sep" "$sep" "$sep"

    # Find max row count across all columns (wc -l pads with spaces on BSD)
    local max_rows=0
    for col in todo inprogress blocked done; do
        local cnt=0
        [ -f "$tmpdir/$col" ] && cnt=$(wc -l < "$tmpdir/$col" | tr -d ' ')
        [ "$cnt" -gt "$max_rows" ] && max_rows="$cnt"
    done

    # Print rows
    local i=1
    while [ "$i" -le "$max_rows" ]; do
        local t ip bl d
        t=$(  [ -f "$tmpdir/todo" ]       && sed -n "${i}p" "$tmpdir/todo"       || true)
        ip=$( [ -f "$tmpdir/inprogress" ] && sed -n "${i}p" "$tmpdir/inprogress" || true)
        bl=$( [ -f "$tmpdir/blocked" ]    && sed -n "${i}p" "$tmpdir/blocked"    || true)
        d=$(  [ -f "$tmpdir/done" ]       && sed -n "${i}p" "$tmpdir/done"       || true)
        printf " %-48s   %-48s   %-48s   %-48s\n" \
            "${t:-}" "${ip:-}" "${bl:-}" "${d:-}"
        i=$(( i + 1 ))
    done
    printf "\n"
}

# ── Main ──────────────────────────────────────────────────────────────────────
BOARD_MODE=false
ARGS=""
for arg in "$@"; do
    if [ "$arg" = "--board" ]; then
        BOARD_MODE=true
    else
        ARGS="$ARGS $(printf '%s' "$arg")"
    fi
done
# Rebuild positional params
# shellcheck disable=SC2086
set -- $ARGS

if [ $# -eq 0 ]; then
    # Summary mode: all types
    printf "\n"
    printf "\033[0;36m\033[1mAxon Engineering Workspace\033[0m\n"
    printf "\033[0;36mDocs root: %s\033[0m\n" "$DOCS_DIR"
    printf "\n"
    printf "\033[1mProject Management:\033[0m\n"
    for type in epic task meeting; do
        local_subdir="$DOCS_DIR/$(type_dir "$type")"
        count=0
        for f in "$local_subdir"/[0-9]*.adoc; do [ -e "$f" ] && count=$(( count + 1 )); done
        printf "  \033[1m%-14s\033[0m %d document(s)\n" "$type" "$count"
    done
    printf "\n"
    printf "\033[1mArchitecture & Decisions:\033[0m\n"
    for type in adr tdr experiment; do
        local_subdir="$DOCS_DIR/$(type_dir "$type")"
        count=0
        for f in "$local_subdir"/[0-9]*.adoc; do [ -e "$f" ] && count=$(( count + 1 )); done
        printf "  \033[1m%-14s\033[0m %d document(s)\n" "$type" "$count"
    done
    printf "\n"
    printf "\033[1mSupporting Documents:\033[0m\n"
    for type in data-card model-card runbook guideline; do
        local_subdir="$DOCS_DIR/$(type_dir "$type")"
        count=0
        for f in "$local_subdir"/[0-9]*.adoc; do [ -e "$f" ] && count=$(( count + 1 )); done
        printf "  \033[1m%-14s\033[0m %d document(s)\n" "$type" "$count"
    done
    printf "\n"
    printf "Run 'axon list <type>' to see details. Use 'axon list task --board' for Kanban view.\n"
    printf "\n"
else
    TYPE="$1"

    if [ -z "$(type_dir "$TYPE")" ]; then
        printf "Unknown type: '%s'. Valid: adr, tdr, experiment, epic, task, meeting, data-card, model-card, runbook, guideline\n" "$TYPE" >&2
        exit 1
    fi

    TYPE_UPPER=$(echo "$TYPE" | tr '[:lower:]' '[:upper:]')

    printf "\n"
    printf "\033[0;36m\033[1m%s documents\033[0m — %s/%s/\n" "$TYPE_UPPER" "$DOCS_DIR" "$(type_dir "$TYPE")"
    printf "\n"

    if [ "$TYPE" = "task" ] && $BOARD_MODE; then
        list_task_board
    else
        if [ "$TYPE" = "task" ]; then
            printf "  %-6s %-8s %-42s %-18s %s\n" "#" "CLASS" "SLUG" "ASSIGNEE" "STATUS"
            printf "  %s\n" "$(printf '─%.0s' $(seq 1 90))"
        elif [ "$TYPE" = "epic" ]; then
            printf "  %-6s %-10s %-42s %s\n" "#" "PRIORITY" "SLUG" "STATUS"
            printf "  %s\n" "$(printf '─%.0s' $(seq 1 70))"
        elif [ "$TYPE" = "meeting" ]; then
            printf "  %-6s %-12s %-42s %s\n" "#" "DATE" "SLUG" "STATUS"
            printf "  %s\n" "$(printf '─%.0s' $(seq 1 72))"
        fi
        list_type "$TYPE"
    fi
    printf "\n"
fi
