#!/usr/bin/env bash
set -euo pipefail
eval "$($(dirname "$0")/axon-config)"

## usage: axon new <TYPE> <TITLE WORDS...> [-s SUPERSEDED] [-c CLASS] [--notebook]
##
## Creates a new, numbered document of the given type. The TITLE WORDS are
## concatenated to form the document title. The file is opened for editing in
## the editor specified by the VISUAL or EDITOR environment variable (VISUAL
## is preferred). After editing, the filename is printed to stdout.
##
## TYPE must be one of:
##   adr         Architecture Decision Record  → adrs/
##   tdr         Technical Debt / Risk Record  → tdrs/
##   experiment  Tracked experiment            → experiments/
##   epic        High-level project epic       → epics/
##   task        Project / engineering task    → tasks/
##   meeting     Meeting schedule & minutes    → meetings/
##   data-card   Dataset documentation card    → data-cards/
##   model-card  ML model documentation card   → model-cards/
##   runbook     Operational runbook           → runbooks/
##   guideline   Coding / design guideline     → guidelines/
##
## Options:
##   -s NUM       Mark existing document NUM as superseded by the new document
##                (only applies to adr and tdr types)
##   -c CLASS     Set the task class (only applies to task and experiment types)
##                Standard: BUG | FEAT | TASK | SPIKE | CHORE | EPIC
##                Scientific: HYPO | DATA | CALIB | REPRO | META | ANLYS
##   --notebook   Also create a companion Jupyter notebook (.ipynb) for experiments
##
## Examples:
##   axon new adr "Use PostgreSQL as the operational database"
##   axon new adr -s 3 "Switch to CockroachDB for global deployments"
##   axon new tdr "Memory leak in NLP worker under high load"
##   axon new epic "Migrate to event-driven architecture"
##   axon new task -c FEAT "Add OAuth2 login flow"
##   axon new task -c HYPO "Validate latency improvement hypothesis"
##   axon new experiment "Redis vs Memcached for session storage"
##   axon new experiment --notebook "Transformer fine-tuning benchmark"
##   axon new meeting "Sprint 12 Planning"
##   axon new data-card "Raw User Events Dataset"
##   axon new model-card "Sentiment Classifier v2"
##   axon new runbook "Deploy to Kubernetes Production"
##   axon new guideline "REST API Design Standards"
##
## Once an experiment succeeds, promote it to an ADR:
##   axon promote <EXPERIMENT_NUM>

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'
success() { printf "${GREEN}[axon] \xe2\x9c\x93${NC} %s\n" "$*"; }
error()   { printf "${RED}[axon] \xe2\x9c\x97${NC} %s\n" "$*" >&2; }

# ── Type → subdir helper (portable; no associative arrays required) ────────────
type_dir() {
    case "$1" in
        adr)        echo "adrs" ;;
        tdr)        echo "tdrs" ;;
        data-card)  echo "data-cards" ;;
        model-card) echo "model-cards" ;;
        runbook)    echo "runbooks" ;;
        guideline)  echo "guidelines" ;;
        experiment) echo "experiments" ;;
        epic)       echo "epics" ;;
        task)       echo "tasks" ;;
        meeting)    echo "meetings" ;;
        *)          echo "" ;;
    esac
}

# Arc42 aggregator files that get auto-updated with include:: directives
type_aggregator() {
    case "$1" in
        adr) echo "arc42/09_architecture_decisions.adoc" ;;
        tdr) echo "arc42/11_technical_risks.adoc" ;;
        *)   echo "" ;;
    esac
}

# Default status per type
type_status() {
    case "$1" in
        adr)        echo "ACCEPTED" ;;
        tdr)        echo "OPEN" ;;
        data-card)  echo "DRAFT" ;;
        model-card) echo "DRAFT" ;;
        runbook)    echo "ACTIVE" ;;
        guideline)  echo "ACTIVE" ;;
        experiment) echo "ACTIVE" ;;
        epic)       echo "PLANNING" ;;
        task)       echo "TODO" ;;
        meeting)    echo "SCHEDULED" ;;
        *)          echo "DRAFT" ;;
    esac
}

# Valid task classes (standard + scientific)
VALID_TASK_CLASSES="BUG FEAT TASK SPIKE CHORE EPIC HYPO DATA CALIB REPRO META ANLYS"

# ── Parse type ────────────────────────────────────────────────────────────────
if [ $# -eq 0 ]; then
    error "No document type given."
    printf "Usage: axon new <TYPE> <TITLE...> [-s NUM] [-c CLASS] [--notebook]\n" >&2
    printf "Types: adr, tdr, epic, task, meeting, experiment, data-card, model-card, runbook, guideline\n" >&2
    exit 1
fi

TYPE="$1"
shift

if [ -z "$(type_dir "$TYPE")" ]; then
    error "Unknown document type: '$TYPE'"
    printf "Valid types: adr, tdr, epic, task, meeting, experiment, data-card, model-card, runbook, guideline\n" >&2
    exit 1
fi

# ── Parse options ─────────────────────────────────────────────────────────────
SUPERSEDED=""
TASK_CLASS="TASK"
CREATE_NOTEBOOK=false

# Pre-scan for --notebook (long option not handled by getopts)
ARGS_FILTERED=""
for arg in "$@"; do
    if [ "$arg" = "--notebook" ]; then
        CREATE_NOTEBOOK=true
    else
        ARGS_FILTERED="$ARGS_FILTERED$(printf '\x01%s' "$arg")"
    fi
done

# Rebuild positional parameters from null-delimited string
if [ -n "$ARGS_FILTERED" ]; then
    # Use a temp file to safely rebuild args with IFS
    set -f
    IFS=$'\x01'
    # shellcheck disable=SC2086
    set -- $ARGS_FILTERED
    unset IFS
    set +f
    # Drop the leading empty element caused by the leading \x01
    if [ "${1:-}" = "" ]; then shift; fi
else
    set --
fi

while getopts "s:c:" opt; do
    case "$opt" in
        s) SUPERSEDED="$SUPERSEDED $OPTARG" ;;
        c) TASK_CLASS="$OPTARG" ;;
        *) error "Unknown option: -$opt"; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

# ── Validate task class ───────────────────────────────────────────────────────
if [ "$TYPE" = "task" ] || [ "$TYPE" = "experiment" ]; then
    TASK_CLASS_UPPER=$(echo "$TASK_CLASS" | tr '[:lower:]' '[:upper:]')
    VALID=false
    for cls in $VALID_TASK_CLASSES; do
        [ "$cls" = "$TASK_CLASS_UPPER" ] && VALID=true && break
    done
    if ! $VALID; then
        error "Unknown class: '$TASK_CLASS'"
        printf "Valid classes (Standard): BUG FEAT TASK SPIKE CHORE EPIC\n" >&2
        printf "Valid classes (Scientific): HYPO DATA CALIB REPRO META ANLYS\n" >&2
        exit 1
    fi
    TASK_CLASS="$TASK_CLASS_UPPER"
fi

# ── Validate title ────────────────────────────────────────────────────────────
TITLE="$*"
if [ -z "$TITLE" ]; then
    error "No title given. Usage: axon new $TYPE <Title Words...>"
    exit 1
fi

# ── Resolve documentation root ────────────────────────────────────────────────
# Honour AXON_DOCS_DIR (set by init to avoid double-lookup), else walk up
if [ -n "${AXON_DOCS_DIR:-}" ]; then
    DOCS_DIR="$AXON_DOCS_DIR"
else
    DOCS_DIR="$("$axon_bin_dir/_axon_dir")"
fi

SUBDIR="$DOCS_DIR/$(type_dir "$TYPE")"
mkdir -p "$SUBDIR"

# ── Calculate next sequential number ─────────────────────────────────────────
if ls "$SUBDIR"/*.adoc >/dev/null 2>&1; then
    MAXID=$(ls "$SUBDIR"/*.adoc 2>/dev/null \
        | while IFS= read -r f; do basename "$f"; done \
        | grep -Eo '^[0-9]+' \
        | sed 's/^0*//' \
        | sort -rn \
        | head -1)
    NEWNUM=$(( MAXID + 1 ))
else
    NEWNUM=1
fi

NEWID=$(printf "%04d" "$NEWNUM")
SLUG=$(echo "$TITLE" | tr -cs '[:alnum:]' '-' | tr '[:upper:]' '[:lower:]' | sed 's/^-//;s/-$//')
DSTFILE="$SUBDIR/${NEWID}-${SLUG}.adoc"
DATE="${AXON_DATE:-$(date +%Y-%m-%d)}"
STATUS="$(type_status "$TYPE")"

# ── Choose template ───────────────────────────────────────────────────────────
# Prefer a custom template in the workspace first, then fall back to built-in
CUSTOM_TEMPLATE="$DOCS_DIR/templates/${TYPE}.adoc"
if [ -f "$CUSTOM_TEMPLATE" ]; then
    TEMPLATE="$CUSTOM_TEMPLATE"
else
    TEMPLATE="$axon_template_dir/doc-types/${TYPE}.adoc"
fi

if [ ! -f "$TEMPLATE" ]; then
    error "Template not found: $TEMPLATE"
    exit 1
fi

# Render template — substitute EXP-NUMBER and EPIC-NUMBER BEFORE NUMBER to avoid partial match
sed \
    -e "s|EXP-NUMBER|EXP-${NEWID}|g" \
    -e "s|EPIC-NUMBER|EPIC-${NEWID}|g" \
    -e "s|NUMBER|${NEWNUM}|g" \
    -e "s|TITLE|${TITLE}|g" \
    -e "s|DATE|${DATE}|g" \
    -e "s|STATUS|${STATUS}|g" \
    -e "s|CLASS|${TASK_CLASS}|g" \
    -e "s|SLUG|${SLUG}|g" \
    "$TEMPLATE" > "$DSTFILE"

# ── Handle supersession (-s flag) ─────────────────────────────────────────────
for target_num in $SUPERSEDED; do
    target_id=$(printf "%04d" "$target_num")
    target_file=$(ls "$SUBDIR/${target_id}-"*.adoc 2>/dev/null | head -1)

    if [ -z "$target_file" ]; then
        printf "[axon] WARNING: Could not find %s #%s to mark as superseded.\n" "$TYPE" "$target_num" >&2
        continue
    fi

    # Mark target as superseded (update its Status line) — portable sed -i
    _sed_inplace() { local f="$1"; shift; sed "$@" "$f" > "${f}.bak" && mv "${f}.bak" "$f"; }
    _sed_inplace "$target_file" "s|^\*Status:\* \`.*\`|\*Status:\* \`SUPERSEDED\`|"

    # Append superseded-by note to target
    printf "\n_Superseded by link:%s-%s.adoc[#%s %s]_\n" "$NEWID" "$SLUG" "$NEWNUM" "$TITLE" >> "$target_file"

    # Append supersedes note to new file
    printf "\n_Supersedes link:%s[#%s]_\n" "$(basename "$target_file")" "$target_num" >> "$DSTFILE"
done

# ── Auto-inject include:: into Arc42 aggregator (ADR + TDR only) ─────────────
AGGREGATOR_REL="$(type_aggregator "$TYPE")"
if [ -n "$AGGREGATOR_REL" ]; then
    AGGREGATOR="$DOCS_DIR/${AGGREGATOR_REL}"
    if [ -f "$AGGREGATOR" ]; then
        INCLUDE_LINE="include::../${SUBDIR##*/}/${NEWID}-${SLUG}.adoc[]"
        # Insert the separator + include before the closing :leveloffset: -1
        # Use a temporary file for portability with both GNU and BSD sed
        TMPFILE=$(mktemp)
        awk -v line="$INCLUDE_LINE" '
            /^:leveloffset: -1/ {
                print ""
                print "// horizontal line"
                print "***"
                print "<<<<"
                print line
                print ""
            }
            { print }
        ' "$AGGREGATOR" > "$TMPFILE"
        mv "$TMPFILE" "$AGGREGATOR"
    fi
fi

# ── Optionally create companion Jupyter notebook (experiments only) ───────────
if [ "$TYPE" = "experiment" ] && $CREATE_NOTEBOOK; then
    NOTEBOOK_TEMPLATE="$axon_template_dir/doc-types/experiment.ipynb"
    NOTEBOOK_CUSTOM="$DOCS_DIR/templates/experiment.ipynb"
    [ -f "$NOTEBOOK_CUSTOM" ] && NOTEBOOK_TEMPLATE="$NOTEBOOK_CUSTOM"

    if [ -f "$NOTEBOOK_TEMPLATE" ]; then
        NOTEBOOK_FILE="$SUBDIR/${NEWID}-${SLUG}.ipynb"
        sed \
            -e "s|EXP-NUMBER|EXP-${NEWID}|g" \
            -e "s|NUMBER-SLUG|${NEWID}-${SLUG}|g" \
            -e "s|NUMBER|${NEWNUM}|g" \
            -e "s|TITLE|${TITLE}|g" \
            -e "s|DATE|${DATE}|g" \
            -e "s|SLUG|${SLUG}|g" \
            "$NOTEBOOK_TEMPLATE" > "$NOTEBOOK_FILE"
        success "Notebook: $NOTEBOOK_FILE"
        # Record link in the adoc report
        printf "\n// Companion notebook: link:%s-%s.ipynb[Jupyter Notebook]\n" "$NEWID" "$SLUG" >> "$DSTFILE"
    else
        printf "[axon] WARNING: Notebook template not found at %s — skipping.\n" "$NOTEBOOK_TEMPLATE" >&2
    fi
fi

# ── Open in editor ────────────────────────────────────────────────────────────
${VISUAL:-${EDITOR:-true}} "$DSTFILE"

success "Created: $DSTFILE"
echo "$DSTFILE"
