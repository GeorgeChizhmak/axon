#!/usr/bin/env bash
set -e

# Establish the core execution paths
axon_bin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
eval "$("$axon_bin_dir/axon-config")"

## usage: axon help [COMMAND]
##
## Displays help for axon commands.
## If COMMAND is given, shows detailed help for that specific command.
##
## Available commands:
##   init       Initialise a new documentation workspace
##   new        Create a new document (adr, tdr, data-card, etc.)
##   generate   Build HTML/PDF or export PlantUML diagrams
##   board      Refresh visual task board (BOARD.adoc) and compile HTML
##   list       List documents of a given type
##   promote    Promote a successful experiment to an ADR
##   version    Print version and authorship
##   help       Show this help

CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

if [ $# -eq 0 ]; then
    printf "\n"
    printf "  ${CYAN}(A)(X)(O)(N)(_  _)(_)(_)${NC}\n"
    printf "  ${CYAN}===============================${NC}\n"
    printf "  ${BOLD}Engineering Workspace Ecosystem${NC}\n"
    printf "  ${CYAN}===============================${NC}\n"
    printf "\n"
    printf "  Connecting Blueprints, Science, and Execution.\n"
    printf "\n"
    printf "Usage: axon COMMAND [ARGS...]\n"
    printf "\n"
    printf "${BOLD}Commands:${NC}\n"

    for cmd in "$axon_bin_dir"/axon-*; do
        name=$(basename "$cmd" | sed 's/^axon-//')
        # Extract the first ## usage: line for a one-liner description
        usage=$(grep -m1 '^## usage:' "$cmd" 2>/dev/null | sed 's/^## usage: //' || true)
        if [ -n "$usage" ]; then
            printf "  %-12s %s\n" "$name" "${usage#*axon $name }"
        else
            printf "  %-12s\n" "$name"
        fi
    done

    printf "\n"
    printf "Run 'axon help COMMAND' for detailed help on a specific command.\n"
    printf "\n"
else
    cmd="$axon_bin_dir/axon-$1"
    if [ -f "$cmd" ]; then
        # Print all ## comment lines, stripping the leading "## "
        grep '^##' "$cmd" | sed 's/^## \{0,1\}//'
    else
        printf "Unknown command: %s\n" "$1" >&2
        exit 1
    fi
fi
