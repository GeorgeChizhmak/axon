#!/usr/bin/env bash
set -euo pipefail
eval "$($(dirname "$0")/axon-config)"

## usage: axon generate [OPTIONS]
##
## Rebuilds the full architecture documentation from source files:
##
##   1. Exports workspace.dsl → PlantUML via Docker + Structurizr CLI
##   2. Cleans stale asciidoctor-diagram SVG caches
##   3. Renders the master .adoc → HTML
##   4. Renders the master .adoc → PDF
##
## Options:
##   --html        Render HTML only
##   --pdf         Render PDF only
##   --all         Render both HTML and PDF (default)
##   --skip-dsl    Skip the Structurizr DSL export step (no Docker needed)
##   --skip-clean  Skip cleaning stale SVG / diagram caches
##
## Prerequisites (install once):
##   gem install asciidoctor asciidoctor-pdf asciidoctor-diagram
##   Docker must be running (unless --skip-dsl is given)
##
## Example:
##   axon generate
##   axon generate --html --skip-dsl

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'
info()    { printf "${CYAN}[axon]${NC} %s\n" "$*"; }
success() { printf "${GREEN}[axon] \xe2\x9c\x93${NC} %s\n" "$*"; }
warn()    { printf "${YELLOW}[axon] \xe2\x9a\xa0${NC} %s\n" "$*"; }
error()   { printf "${RED}[axon] \xe2\x9c\x97${NC} %s\n" "$*" >&2; }

# ── Parse flags ───────────────────────────────────────────────────────────────
DO_HTML=true
DO_PDF=true
DO_DSL=true
DO_CLEAN=true
EXPLICIT_FORMAT=false

for arg in "$@"; do
    case "$arg" in
        --html)       DO_HTML=true;  DO_PDF=false; EXPLICIT_FORMAT=true ;;
        --pdf)        DO_PDF=true;   DO_HTML=false; EXPLICIT_FORMAT=true ;;
        --all)        DO_HTML=true;  DO_PDF=true ;;
        --skip-dsl)   DO_DSL=false ;;
        --skip-clean) DO_CLEAN=false ;;
        *)
            error "Unknown option: $arg"
            printf "Usage: axon generate [--html] [--pdf] [--all] [--skip-dsl] [--skip-clean]\n" >&2
            exit 1
            ;;
    esac
done

# ── Resolve workspace ─────────────────────────────────────────────────────────
DOCS_DIR="$("$axon_bin_dir/_axon_dir")"
DIAGRAMS_DIR="$DOCS_DIR/diagrams"

# Auto-detect the master .adoc file (the one that is NOT in arc42/ subdir)
MASTER_ADOC=$(find "$DOCS_DIR" -maxdepth 1 -name "*.adoc" ! -name "README.adoc" | head -1)

if [ -z "$MASTER_ADOC" ]; then
    error "No master .adoc file found in $DOCS_DIR/"
    error "Run 'axon init' first to set up the workspace."
    exit 1
fi

PROJECT_BASENAME=$(basename "$MASTER_ADOC" .adoc)

printf "\n"
printf "${CYAN}══════════════════════════════════════════════════════${NC}\n"
printf "${CYAN}   axon — Building Documentation                       ${NC}\n"
printf "${CYAN}══════════════════════════════════════════════════════${NC}\n"
printf "\n"
info "Master doc  : $MASTER_ADOC"
info "Diagrams dir: $DIAGRAMS_DIR"
printf "\n"

# ── 1. Check prerequisites ─────────────────────────────────────────────────────
check_prereqs() {
    local missing=0

    if $DO_DSL; then
        if ! command -v docker >/dev/null 2>&1; then
            error "Docker is not installed or not in PATH. Use --skip-dsl to skip DSL export."
            missing=1
        elif ! docker info >/dev/null 2>&1; then
            error "Docker daemon is not running. Use --skip-dsl to skip DSL export."
            missing=1
        fi
    fi

    if $DO_HTML || $DO_PDF; then
        if ! command -v asciidoctor >/dev/null 2>&1; then
            error "'asciidoctor' not found. Run: gem install asciidoctor asciidoctor-diagram"
            missing=1
        fi
    fi

    if $DO_PDF; then
        if ! command -v asciidoctor-pdf >/dev/null 2>&1; then
            error "'asciidoctor-pdf' not found. Run: gem install asciidoctor-pdf"
            missing=1
        fi
    fi

    if [ $missing -ne 0 ]; then
        exit 1
    fi
}

# ── 2. Export Structurizr DSL → PlantUML ──────────────────────────────────────
export_dsl() {
    info "Exporting Structurizr DSL → PlantUML..."

    local workspace_dsl="$DOCS_DIR/workspace.dsl"
    if [ ! -f "$workspace_dsl" ]; then
        warn "workspace.dsl not found at $workspace_dsl — skipping DSL export."
        return 0
    fi

    mkdir -p "$DIAGRAMS_DIR"

    # Mount the project root so that the !docs and !adrs directives resolve correctly
    PROJECT_ROOT="$(cd "$DOCS_DIR/.." && pwd)"

    docker run --rm \
        -v "${PROJECT_ROOT}:/usr/local/structurizr" \
        structurizr/structurizr export \
        -workspace "/usr/local/structurizr/${DOCS_DIR#"$PROJECT_ROOT"/}/workspace.dsl" \
        -format plantuml/structurizr \
        -output "/usr/local/structurizr/${DOCS_DIR#"$PROJECT_ROOT"/}/diagrams"

    success "PlantUML files written to $DIAGRAMS_DIR/"
}

# ── 3. Clean stale SVG caches ─────────────────────────────────────────────────
clean_stale_svgs() {
    info "Cleaning stale diagram caches..."

    local stale_count=0

    # Remove auto-generated SVGs from asciidoctor-diagram
    # Use find with -exec for portability (avoids process substitution with -print0)
    while IFS= read -r f; do
        rm -f "$f"
        stale_count=$(( stale_count + 1 ))
    done < <(find "$DIAGRAMS_DIR" -maxdepth 1 -name "diag-*.svg" 2>/dev/null)

    # Wipe the .asciidoctor diagram cache directory
    if [ -d "$DOCS_DIR/.asciidoctor/diagram" ]; then
        rm -rf "$DOCS_DIR/.asciidoctor/diagram"
        stale_count=$(( stale_count + 1 ))
    fi

    if [ "$stale_count" -gt 0 ]; then
        success "Removed $stale_count stale file(s)."
    else
        info "No stale files found."
    fi
}

# ── 4. Render HTML ────────────────────────────────────────────────────────────
render_html() {
    info "Rendering HTML..."

    local out="$DOCS_DIR/${PROJECT_BASENAME}_architecture.html"
    asciidoctor \
        -r asciidoctor-diagram \
        "$MASTER_ADOC" \
        -o "$out"

    success "HTML → $out"
}

# ── 5. Render PDF ─────────────────────────────────────────────────────────────
render_pdf() {
    info "Rendering PDF..."

    local out="$DOCS_DIR/${PROJECT_BASENAME}_architecture.pdf"
    asciidoctor-pdf \
        -r asciidoctor-diagram \
        "$MASTER_ADOC" \
        -o "$out"

    success "PDF  → $out"
}

# ── Main ──────────────────────────────────────────────────────────────────────
check_prereqs

$DO_DSL    && export_dsl
$DO_CLEAN  && clean_stale_svgs
$DO_HTML   && render_html
$DO_PDF    && render_pdf

printf "\n"
success "Build complete. Files ready to commit:"
$DO_HTML && printf "    %s/%s_architecture.html\n" "$DOCS_DIR" "$PROJECT_BASENAME"
$DO_PDF  && printf "    %s/%s_architecture.pdf\n"  "$DOCS_DIR" "$PROJECT_BASENAME"
$DO_DSL  && printf "    %s/\n" "$DIAGRAMS_DIR"
printf "\n"
